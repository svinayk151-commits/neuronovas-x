{
  "name": "food-donation-platform",
  "version": "1.0.0",
  "description": "Hackathon prototype – food surplus coordination platform",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "seed": "node server/db/seed.js",
    "seed:reset": "node server/db/seed.js --reset",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
